{
  "name": "almanfz-web",
  "version": "1.0.0",
  "private": true,
  "description": "Almanfz — Electrical & Mechanical Supplies. B2B catalog and quotation website.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test --experimental-strip-types --no-warnings \"tests/unit/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "catalog:import": "node --experimental-strip-types scripts/import-catalog.ts",
    "catalog:validate": "node --experimental-strip-types scripts/validate-catalog.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
