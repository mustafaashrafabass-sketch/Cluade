# Copy to .env.local for development. Never commit real values.

# Public URL of the site (canonical URLs, sitemap, Open Graph, WhatsApp links)
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Set to "false" on staging/preview deployments to block search indexing
NEXT_PUBLIC_ALLOW_INDEXING=true

# ── Catalog ──────────────────────────────────────────────────────────────
# Directory with products.json / categories.json / meta.json (default data/catalog)
# CATALOG_DATA_DIR=data/catalog
# Hosts allowed for remote product images, comma-separated (default: almanfz.com,www.almanfz.com).
# Not needed when images were copied locally with `catalog:import --download-images`.
# CATALOG_IMAGE_HOSTS=almanfz.com,www.almanfz.com

# ── Lead destinations (quote, BOQ/RFQ and contact forms) ─────────────────
# Comma-separated: webhook, email, file. A submission succeeds only if at
# least one configured destination confirms it. With none configured the
# forms tell visitors their request was NOT sent.
LEAD_DESTINATIONS=webhook,email

# webhook: POSTs JSON (see docs/LEADS.md) to your CRM / automation endpoint
LEAD_WEBHOOK_URL=https://hooks.example.com/your-endpoint
# Optional HMAC-SHA256 signing secret, sent as X-Almanfz-Signature: sha256=<hex>
LEAD_WEBHOOK_SECRET=replace-with-a-long-random-string

# email: sends each lead (with attachment) through the Resend API
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
LEAD_EMAIL_TO=sales@example.com
LEAD_EMAIL_FROM=Almanfz Website <website@example.com>

# file: local development fallback, writes JSON + attachments to LEAD_FILE_DIR.
# Disabled in production unless explicitly allowed (only on a server with a persistent, backed-up disk).
# LEAD_FILE_DIR=.data/leads
# LEAD_FILE_STORE_ALLOW_PRODUCTION=false

# ── Analytics (optional, loaded only after visitor consent) ──────────────
# Use GTM *or* GA4. Leave empty to disable analytics and the consent banner.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
